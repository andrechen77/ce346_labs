&pinctrl {
    pwm1_default_alt: pwm1_default_alt {
        group1  {
            psels = <NRF_PSEL(PWM_OUT0,0,13)>;
            nordic,invert;
        };
    };
    pwm1_sleep_alt: pwm1_sleep_alt_alt {
        group1  {
            psels = <NRF_PSEL(PWM_OUT0,0,13)>;
            low-power-enable;
        };
    };
};

&adc {
	status = "okay";
    label = "ADC_0";
};

&pwm1 {
	status = "okay";
    pinctrl-0 = <&pwm1_default_alt>;
    pinctrl-1 = <&pwm1_sleep_alt>;
    pinctrl-names = "default", "sleep";

    label="PWM_1";
};
